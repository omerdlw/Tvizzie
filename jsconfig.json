{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "module": "esnext",
    "target": "esnext",
    "checkJs": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "@/core/*": ["./core/*"],
      "@/modules/*": ["./core/modules/*"],
      "@/ui/*": ["./core/ui/*"],
      "@/shared/*": ["./core/shared/*"],
      "@/ui/elements": ["./core/ui/primitives/index.js"],
      "@/ui/elements/*": ["./core/ui/primitives/*"],
      "@/ui/animations/*": ["./core/ui/motion/animations/*"],
      "@/ui/loadings/spinner": ["./core/ui/feedback/spinner.js"],
      "@/ui/states/fullscreen-state": ["./core/ui/feedback/fullscreen-state.js"],
      "@/ui/skeletons/components/nav": ["./app/_shell/navigation/nav-skeleton.js"],
      "@/ui/loadings/*": ["./core/ui/feedback/*"],
      "@/ui/states/*": ["./core/ui/feedback/*"],
      "@/ui/skeletons/*": ["./core/ui/feedback/*"],
      "@/ui/icon": ["./core/ui/primitives/icon.js"],
      "@/ui/media/*": ["./domains/media/ui/*"]
    }
  }
}
