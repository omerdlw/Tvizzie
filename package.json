{
  "name": "tvizzie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./*"
  },
  "scripts": {
    "dev": "next dev",
    "analyze": "ANALYZE=true next build --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "upload": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run check:architecture && npm run lint && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file=.env --import ./scripts/register-alias.mjs scripts/test-supabase-runtime.mjs",
    "seed:dev:large": "ALLOW_DEV_DATABASE_RESET=1 node --env-file=.env scripts/dev-seed-dataset.mjs --yes --reset-all-dev-data"
  },
  "dependencies": {
    "@iconify-icon/react": "^3.0.3",
    "@next/bundle-analyzer": "^16.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/react": "19.2.18",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "wrangler": "^4.120.0"
  }
}
